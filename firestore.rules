rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Mengizinkan user yang telah login membaca dan menulis data
    // Setiap query di aplikasi sudah difilter per user (where('uid', '==', user.uid))
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
